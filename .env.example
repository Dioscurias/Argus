# No environment file or API keys are needed for mock mode.
MOCK_DATA_MODE=true
HOST=127.0.0.1
PORT=3001
MOCK_SEED=42
MOCK_AIR_COUNT=640
MOCK_SEA_COUNT=420
MOCK_TRUCK_COUNT=180
POLL_INTERVAL_MS=2000
CACHE_TTL_MS=1500
# Server-side only. MOCK_DATA_MODE=false enables observed air on a single Node backend.
# Vercel stays in mock mode until a shared account-wide provider poller/cache is added.
AIR_PROVIDER=fr24
AIR_FALLBACK_PROVIDER=opensky
AIR_BOUNDS=60,15,-130,-60
AIR_POLL_INTERVAL_MS=60000
ADSB_POINT=39,-98,250
FR24_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AISSTREAM_API_KEY=
# Optional additional browser origin when serving the client separately.
CLIENT_ORIGIN=
