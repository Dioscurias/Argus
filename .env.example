# No environment file or API keys are needed for mock mode.
MOCK_DATA_MODE=true
HOST=127.0.0.1
PORT=3001
MOCK_SEED=42
MOCK_AIR_COUNT=640
MOCK_SEA_COUNT=420
MOCK_TRUCK_COUNT=180
POLL_INTERVAL_MS=2000
CACHE_TTL_MS=1500
# Server-side only. OpenSky OAuth enables broad network coverage.
AIR_PROVIDER=opensky
AIR_FALLBACK_PROVIDER=adsblol
AIR_BOUNDS=90,-90,-180,180
AIR_POLL_INTERVAL_MS=90000
ADSB_POINT=39,-98,250
FR24_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AISSTREAM_API_KEY=
# Optional additional browser origin when serving the client separately.
CLIENT_ORIGIN=
